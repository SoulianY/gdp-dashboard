<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Settings.Heading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAppearance">@style/Text.Title</item>
    </style>
    <style name="Settings.Help" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">@style/Text.Small</item>
    </style>
    <style name="Settings.Sheet" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/sheet</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
