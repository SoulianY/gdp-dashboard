<?xml version="1.0" encoding="utf-8"?>
<!-- 설정: 묶음마다 제목 · 한 줄 설명 · 흰 면 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp">

        <TextView style="@style/Settings.Heading" android:text="상태" />

        <LinearLayout style="@style/Settings.Sheet">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:textAppearance="@style/Text.Body" />

            <Button
                android:id="@+id/grant"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="알림 접근 권한 설정 열기" />
        </LinearLayout>

        <TextView style="@style/Settings.Heading" android:text="앱별 알림 띄우기" />

        <TextView style="@style/Settings.Help" android:text="최근 알림 순. 끈 앱의 알림은 기록만 하고 알림창에서 지웁니다." />

        <LinearLayout
            android:id="@+id/apps"
            style="@style/Settings.Sheet" />

        <TextView style="@style/Settings.Heading" android:text="숨길 단어" />

        <TextView style="@style/Settings.Help" android:text="쉼표로 구분. 제목이나 내용에 있으면 숨깁니다. 업무 프로필 앱은 제외합니다." />

        <LinearLayout style="@style/Settings.Sheet">

            <EditText
                android:id="@+id/words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="(광고), 쿠폰, 이벤트"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <TextView style="@style/Settings.Heading" android:text="카톡 단톡방 1분 제한" />

        <TextView style="@style/Settings.Help" android:text="최근 순. 켠 방은 1분에 한 번만 알림이 뜹니다. 내 이름이 나오면 항상 뜹니다." />

        <LinearLayout style="@style/Settings.Sheet">

            <LinearLayout
                android:id="@+id/rooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/names"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="내 이름 (쉼표로 구분)"
                android:inputType="text" />
        </LinearLayout>

        <TextView style="@style/Settings.Heading" android:text="업로드" />

        <TextView style="@style/Settings.Help" android:text="알림을 올릴 비공개 GitHub 저장소와 토큰" />

        <LinearLayout style="@style/Settings.Sheet">

            <EditText
                android:id="@+id/repo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="저장소 (owner/name)"
                android:inputType="text" />

            <EditText
                android:id="@+id/token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="GitHub 토큰 (Fine-grained PAT)"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="저장하고 지금 올리기" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
